# Copie para .env (cp .env.example .env) e preencha. O .env nunca vai para o git.
# Instruções completas de cada item no CLAUDE.md.

# --- Cloudflare (obrigatório) ---
# Token criado pelo link do CLAUDE.md (já vem com as permissões certas).
CLOUDFLARE_API_TOKEN=
# Opcional: detectado sozinho quando o token enxerga só uma conta.
CLOUDFLARE_ACCOUNT_ID=
# Endereço do site. O domínio precisa estar na sua conta Cloudflare.
APP_HOSTNAME=vendas.seudominio.com.br
# Opcionais (padrão: primeira parte do APP_HOSTNAME, ex.: "vendas" e "vendas-db").
WORKER_NAME=
D1_NAME=

# --- Sua marca ---
# Use aspas em valores com espaço.
BRAND_NAME="Minha Empresa"
# Nome que aparece na fatura do cartão (até 13 letras/números, sem acento).
STATEMENT_DESCRIPTOR=MINHAEMPRESA
# Dias de garantia exibidos no checkout (0 esconde o selo).
GUARANTEE_DAYS=30
# Página aberta quando alguém acessa a raiz do domínio.
DEFAULT_PAGE=exemplo

# --- Dashboard (Basic Auth) ---
DASH_USER=admin
# Deixe vazio para o setup gerar uma senha forte e gravar aqui.
DASH_PASS=

# --- Mercado Pago (obrigatório) ---
MP_PUBLIC_KEY=
MP_ACCESS_TOKEN=

# --- Meta: Pixel e Conversions API (obrigatório) ---
META_PIXEL_ID=
META_PIXEL_ACCESS_TOKEN=
# Opcional: código da aba "Eventos de teste" para validar a CAPI sem sujar dados.
META_TEST_EVENT_CODE=

# --- Meta: Marketing API (tela /meta e skills de campanha) ---
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
# Opcional: várias contas separadas por vírgula (act_1,act_2).
META_AD_ACCOUNT_IDS=
# Usados só pelas skills de criação de campanha.
META_PAGE_ID=
META_IG_USER_ID=
CAMPAIGN_PREFIX=CP

# --- E-mail de confirmação pós-compra (opcional) ---
# Remetente num domínio cadastrado em Cloudflare > Email Service > Email Sending.
EMAIL_FROM=
CLOUDFLARE_EMAIL_API_TOKEN=

# --- Testes E2E (gerado por: npm run setup -- --debug-approve) ---
DEBUG_APPROVE_TOKEN=
